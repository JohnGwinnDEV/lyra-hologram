config_version=5

[application]
config/name="LYRA-Hologram"
run/main_scene="res://scenes/desktop.tscn"

[display]
window/size/viewport_width=1120
window/size/viewport_height=760
window/size/window_width_override=1120
window/size/window_height_override=760
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
